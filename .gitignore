# Publish only software source, dependency manifests, and setup instructions.
# Everything else stays local unless explicitly allowed below.
*
!/.gitignore
!/README.md
!/package.json
!/package-lock.json
!/assets/
!/assets/*.svg
!/backend/
!/backend/pyproject.toml
!/backend/app/
!/backend/app/*.py
!/backend/tests/
!/backend/tests/*.py
!/desktop/
!/desktop/*.cjs
!/desktop/tests/
!/desktop/tests/*.test.cjs
!/frontend/
!/frontend/package.json
!/frontend/package-lock.json
!/frontend/index.html
!/frontend/tsconfig.json
!/frontend/vite.config.ts
!/frontend/public/
!/frontend/public/*.svg
!/frontend/src/
!/frontend/src/**/
!/frontend/src/**/*.ts
!/frontend/src/**/*.tsx
!/frontend/src/**/*.css
!/scripts/
!/scripts/*.sh
!/system/
!/system/*.py

# Defense in depth for private files within allowed source directories.
**/.env
**/.env.*
**/*.ovpn
**/*.key
**/*.pem
**/*.p12
**/*.pfx
**/*credentials*
**/desktop-state.json
**/settings.json
**/*.log
