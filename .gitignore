# Track source, build assets, and explicitly approved split Windows installers.
# Everything else stays local unless explicitly allowed below.
*
!/.gitignore
!/.gitattributes
!/README.md
!/package.json
!/package-lock.json
!/assets/
!/assets/*.svg
!/assets/*.ico
!/assets/*.png
!/backend/
!/backend/pyproject.toml
!/backend/windows_entry.py
!/backend/app/
!/backend/app/*.py
!/backend/tests/
!/backend/tests/*.py
!/desktop/
!/desktop/*.cjs
!/desktop/tests/
!/desktop/tests/*.test.cjs
!/frontend/
!/frontend/package.json
!/frontend/package-lock.json
!/frontend/index.html
!/frontend/tsconfig.json
!/frontend/vite.config.ts
!/frontend/public/
!/frontend/public/*.svg
!/frontend/src/
!/frontend/src/**/
!/frontend/src/**/*.ts
!/frontend/src/**/*.tsx
!/frontend/src/**/*.css
!/scripts/
!/scripts/*.sh
!/scripts/*.ps1
!/scripts/*.nsh
!/scripts/*.cjs
!/system/
!/system/*.py
!/installers/
!/installers/README.md
!/installers/windows/
!/installers/windows/*.exe.part[12]
!/installers/windows/Install.cmd
!/installers/windows/Install.ps1
!/installers/windows/SHA256SUMS.txt

# Defense in depth for private files within allowed source directories.
**/.env
**/.env.*
**/*.ovpn
**/*.key
**/*.pem
**/*.p12
**/*.pfx
**/*credentials*
**/desktop-state.json
**/settings.json
**/helper.token
**/auth.txt
**/*.log
